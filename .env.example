# Copie ce fichier en ".env.local" pour développer en local (jamais commité).
# En production, ces mêmes valeurs se configurent dans Vercel > Settings > Environment Variables.

# Config Firebase (Firebase Console > Paramètres du projet > Vos applications > Config SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clé API Anthropic (console.anthropic.com > API Keys) — UNIQUEMENT côté serveur,
# ne jamais préfixer par VITE_ (ça l'exposerait dans le navigateur).
ANTHROPIC_API_KEY=
