rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toutes les données de l'appli vivent dans la collection "registre"
    // (un document par type : debts, payments, billets…). Accès réservé
    // aux utilisateurs connectés via Firebase Authentication (comptes créés
    // depuis la console Firebase). Tout le reste du projet Firestore reste
    // fermé par défaut.
    match /registre/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
