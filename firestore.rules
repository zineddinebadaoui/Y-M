rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Rôle du compte connecté : "admin" par défaut si aucun document
    // roles/{uid} n'existe (comptes créés avant l'ajout des rôles), sinon
    // la valeur du champ "role" de ce document ("admin" ou "passager").
    function myRole() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
        : 'admin';
    }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function isPassager() { return signedIn() && myRole() == 'passager'; }

    // Toutes les données de gestion (dettes, paiements, rotations, la liste
    // des passagers validés…) : un document par type. Réservé à l'admin —
    // un compte passager n'y a jamais accès, même en lecture.
    match /registre/{document} {
      allow read, write: if isAdmin();
    }

    // Rôle de chaque compte. Chacun peut lire le sien (pour savoir quelle
    // interface afficher au démarrage) ; seul l'admin peut lister tous les
    // comptes ou en créer/modifier.
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Soumission d'un compte passager (nom + pièce jointe + valeurs
    // détectées par le scan IA). Visible/modifiable uniquement par son
    // propre compte, ou par l'admin qui la relit et la valide avant
    // qu'elle ne compte dans les totaux (voir registre/passengers).
    match /passengerSubmissions/{uid} {
      allow read, write: if isAdmin();
      allow read, write: if isPassager() && request.auth.uid == uid;
    }
  }
}
