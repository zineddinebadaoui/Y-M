rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Rôle du compte connecté : UNIQUEMENT la valeur du champ "role" de
    // roles/{uid} ("admin" ou "passager"). L'absence de document n'est
    // jamais traitée comme "admin" — un compte sans rôle explicite n'a
    // accès à rien (voir isAdmin()/isPassager() ci-dessous). Chaque compte
    // admin doit avoir un document roles/{uid} = {role: "admin"} créé une
    // fois depuis la console Firebase (Firestore Database → Data).
    function myRole() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function isPassager() { return signedIn() && myRole() == 'passager'; }

    // Toutes les données de gestion (dettes, paiements, rotations, la liste
    // des passagers validés…) : un document par type. Réservé à l'admin —
    // un compte passager n'y a jamais accès, même en lecture.
    match /registre/{document} {
      allow read, write: if isAdmin();
    }

    // Rôle de chaque compte. Chacun peut lire le sien (pour savoir quelle
    // interface afficher au démarrage) ; seul l'admin peut lister tous les
    // comptes ou en créer/modifier.
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Soumission d'un compte passager (nom + pièce jointe + valeurs
    // détectées par le scan IA). Visible/modifiable uniquement par son
    // propre compte, ou par l'admin qui la relit et la valide avant
    // qu'elle ne compte dans les totaux (voir registre/passengers).
    match /passengerSubmissions/{uid} {
      allow read, write: if isAdmin();
      allow read, write: if isPassager() && request.auth.uid == uid;
    }

    // Réglages généraux (ex. "taux du jour" par devise) : maintenus par
    // l'admin, mais lus par tous les comptes connectés — admin et
    // passager — pour pré-remplir leurs formulaires de change/achat.
    match /settings/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Module "Change de devises" : opérations de change et achats en
    // devise, saisis par l'admin (validés immédiatement) ou par un
    // passager (en attente jusqu'à validation par l'admin). Chacun ne
    // lit/écrit que ses propres saisies (createdBy) ; l'admin voit et gère
    // tout. Une fois validée (status == "valide"), une saisie devient
    // définitive : son auteur passager ne peut plus la modifier ni la
    // supprimer — seul l'admin le peut encore.
    match /exchangeOps/{id} {
      allow read: if isAdmin() || (isPassager() && resource.data.createdBy == request.auth.uid);
      allow create: if isAdmin()
        || (isPassager()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'a_confirmer');
      allow update: if isAdmin()
        || (isPassager()
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'a_confirmer'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'a_confirmer');
      allow delete: if isAdmin()
        || (isPassager()
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'a_confirmer');
    }

    match /purchases/{id} {
      allow read: if isAdmin() || (isPassager() && resource.data.createdBy == request.auth.uid);
      allow create: if isAdmin()
        || (isPassager()
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'a_confirmer');
      allow update: if isAdmin()
        || (isPassager()
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'a_confirmer'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'a_confirmer');
      allow delete: if isAdmin()
        || (isPassager()
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'a_confirmer');
    }
  }
}
