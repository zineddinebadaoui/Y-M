rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos de reçus (change de devises, achats) : chacun ne peut déposer
    // que dans son propre dossier (receipts/{son-uid}/...), et seuls les
    // comptes connectés peuvent les relire (l'accès aux documents Firestore
    // qui référencent ces photos est déjà restreint par firestore.rules).
    match /receipts/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
